                    reasons.push('NPP currently accepts residential properties only.');
                if (d.homeowner !== 'yes')
                    reasons.push('The person requesting the inspection must be the homeowner.');
                if (!NPP_APPROVED_ZIPS.includes(d.zip.trim()))
                    reasons.push('The property ZIP code is not currently included in NPP’s approved service-area ZIP codes.');
                if (d.recentClaim === 'yes')
                    reasons.push('A homeowners’ insurance claim has been filed for this property within the last six months.');
                if (d.openClaim === 'yes')
                    reasons.push('There is currently an open homeowners’ insurance claim for this property.');
                if (reasons.length) {
                    out.innerHTML = '<div class="panel bad"><h3>Thank you for your interest in NPP.</h3><p>Unfortunately, based on the information provided, your property does not currently meet our inspection requirements. We appreciate your interest and thank you for considering NPP.</p><ul>' + reasons.map(x => '<li>' + x + '</li>').join('') + '</ul><p><strong>Demo result: Disqualified. No calendar or appointment step is shown.</strong></p><button class="button dark" type="button" onclick="resetJourney()">Start again</button></div>';
                    return;
                }
                const min = new Date();
                min.setDate(min.getDate() + 1);
                const max = new Date();
                max.setDate(max.getDate() + 30);
                out.innerHTML = '<div class="panel good"><h3>You’re eligible to continue!</h3><p>Your answers meet NPP’s current demo criteria. Choose a sample date and time below.</p><p><strong>ZIP:</strong> ' + d.zip + ' · <strong>Homeowner:</strong> Yes · <strong>Residential:</strong> Yes</p></div><div class="panel" id="calendarPanel"><span class="demo-tag">Sample availability · not a live NPP calendar</span><h3>Select an inspection date</h3><p>These illustrative time slots are not connected to a technician schedule and are not reserved.</p><div class="calendar-grid"><label>Preferred date<input id="demoDate" type="date" min="' + min.toISOString().slice(0, 10) + '" max="' + max.toISOString().slice(0, 10) + '"></label><label>Available time<select id="demoTime"><option value="">Select a date first</option></select></label></div><p><button class="button dark" id="confirmDemo" type="button" disabled onclick="finishJourney()">CONFIRM DEMO APPOINTMENT</button></p><p class="fine">Live GHL placeholder: retrieve real availability, create the appointment after qualification, notify the salesperson and send the homeowner confirmation.</p></div>';
                document.getElementById('calendarPanel').scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest'
                });
            }
            );
            document.addEventListener('change', e => {
                if (e.target.id === 'demoDate') {
                    document.getElementById('demoTime').innerHTML = '<option value="">Choose a time</option><option>9:00 AM</option><option>11:00 AM</option><option>1:00 PM</option><option>3:00 PM</option>';
                    document.getElementById('confirmDemo').disabled = true;
                }
                if (e.target.id === 'demoTime')
                    document.getElementById('confirmDemo').disabled = !e.target.value;
            }
            );
            function finishJourney() {
                const date = document.getElementById('demoDate').value
                  , time = document.getElementById('demoTime').value;
                if (!date || !time)
                    return;
                const nice = new Date(date + 'T12:00:00').toLocaleDateString('en-US', {
                    weekday: 'long',
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric'
                });
                document.getElementById('calendarPanel').innerHTML = '<div class="confirmation"><span class="demo-tag">Simulated booking confirmation</span><h3>Thank You! Your Inspection Request Has Been Received.</h3><p>Your selected appointment has been successfully booked. One of our team members will contact you shortly to confirm your details and appointment. We look forward to assisting you!</p><p><strong>Selected date:</strong> ' + nice + '<br><strong>Selected time:</strong> ' + time + '</p><p><strong>Demo notice:</strong> This is a simulated booking only. No appointment has been created in NPP’s calendar, no time slot has been reserved, and no notification or confirmation has been sent.</p><button class="button dark" onclick="resetJourney()">Run journey again</button></div>';
            }
            function resetJourney() {
                form.reset();
                out.innerHTML = '';
                form.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        </script>
    </body>
</html>
